# Azure Database for PostgreSQL Flexible Server
DBHOST=your-server.postgres.database.azure.com
DBPORT=5432
DBNAME=your_database
DBUSER=news_agent_b_mcp
DBPASSWORD=replace_me
SSLMODE=require

# News Intelligence schema boundary
NEWS_SCHEMA=news_agent
ALLOWED_SCHEMAS=news_agent

# Connection/query safety limits
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# MCP Streamable HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
