# Azure Database for PostgreSQL Flexible Server
DBHOST=your-server.postgres.database.azure.com
DBPORT=5432
DBNAME=your_database
DBUSER=chatgpt_mcp
DBPASSWORD=replace_me
SSLMODE=require

# Safety limits
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000

# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
